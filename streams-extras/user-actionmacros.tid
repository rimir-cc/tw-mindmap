title: $:/plugins/rimir/mindmap/streams-extras/user-actionmacros
tags: $:/tags/streams/user-actionmacros
type: text/vnd.tiddlywiki

\whitespace trim

\define oncontext-menu-actions()
<!-- Right-click on a stream node opens the contextmenu popup. We piggyback
     here to clear the cascade-mode field on contextmenu-state before each
     open, otherwise an aborted Copy/Paste from the last open (popup
     dismissed by outside-click while in sub-menu) would persist and the
     fresh popup would re-open in that sub-menu. The other two actions are
     verbatim from the streams plugin's action-macros. -->
<$action-setfield $tiddler=<<contextmenu-state>> $field="current" $value=<<dom-data-node-title>>/>
<$action-setfield $tiddler=<<contextmenu-state>> $field="position" $value="left"/>
<$action-setfield $tiddler=<<contextmenu-state>> $field="mode" $value=""/>
<$action-popup $coords=<<tv-popup-coords>> $state=<<contextmenu-state>>/>
\end

\define swiped-right-actions()
<!-- Same piggyback for the swipe-right-opens-contextmenu path. -->
<$list filter="[{$:/config/sq/streams/swipe-behaviour}match[contextmenu]]" variable="_NULL">
<$action-setfield $tiddler=<<contextmenu-state>> $field="current" $value=<<dom-data-node-title>>/>
<$action-setfield $tiddler=<<contextmenu-state>> $field="position" $value={{$:/config/sq/streams/swipe-contextmenu-position}}/>
<$action-setfield $tiddler=<<contextmenu-state>> $field="mode" $value=""/>
<$action-popup $coords=<<tv-popup-coords>> $state=<<contextmenu-state>>/>
</$list>
<$list filter="[{$:/config/sq/streams/swipe-behaviour}match[indent]]" variable="_NULL">
<$vars currentTiddler=<<dom-data-node-title>>>
<<indent-node-actions>>
</$vars>
</$list>
\end
