title: $:/plugins/rimir/mindmap/styles
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

/* Container for the $mindmap widget. Engines render into a child div with
   class .rr-mindmap-canvas; the canvas needs a definite height to render. */
.rr-mindmap {
    position: relative;
    width: 100%;
    min-height: 240px;
    display: flex;
    flex-direction: column;
}

/* Warning wash applied when a structural view is in title-label mode —
   drag-rename + drag-reparent mutate filesystem titles (and cascade refs
   via flibbles/relink). Switching the label-field dropdown to caption or
   any other field clears the wash. The canvas tint can't paint over mind-
   elixir's own background, so we frame it instead with a red inset shadow
   that's clearly visible above the engine's drawing. */
.rr-mindmap-title-active {
    background-color: #fff0f0;
}
.rr-mindmap-title-active .rr-mindmap-canvas {
    box-shadow: inset 0 0 0 3px #f88;
}
.rr-mindmap-title-active .rr-mindmap-toolbar {
    background-color: #fee;
    border-top: 3px solid #f88;
    border-bottom: 1px solid #f88;
}
/* Preview pane keeps a neutral background — it's a tiddler-editor surface,
   not the destructive canvas. Override the container's red wash. */
.rr-mindmap-title-active .rr-mindmap-preview {
    background-color: <<colour tiddler-background>>;
}

.rr-mindmap-title-warning {
    display: none;
    margin-left: 0.6em;
    color: #a00;
    font-weight: bold;
    flex: 1 1 auto;
}
.rr-mindmap-title-active .rr-mindmap-title-warning {
    display: inline;
}

/* Horizontal layout under the toolbar: canvas on the left, preview pane
   (when a node is selected) on the right. */
.rr-mindmap-main {
    flex: 1 1 auto;
    display: flex;
    flex-direction: row;
    min-height: 0;
}

.rr-mindmap-canvas {
    flex: 1 1 auto;
    height: 100%;
    min-height: 0;
    min-width: 0;
    position: relative;
}

.rr-mindmap-preview {
    flex: 0 0 35%;
    max-width: 35%;
    height: 100%;
    overflow: auto;
    padding: 12px 16px;
    border-left: 1px solid var(--theme-tiddler-border, #e0e0e0);
    background: var(--theme-tiddler-background, transparent);
    font-size: 0.95em;
}
.rr-mindmap-preview-header {
    font-family: var(--theme-monospace-font, monospace);
    font-size: 0.8em;
    opacity: 0.7;
    margin-bottom: 8px;
    word-break: break-all;
}
/* Modebar at the top of the preview pane: selected-tiddler title on the left,
   inspect-mode dropdown (Body / Slides) on the right. The dropdown lives here
   — not over the canvas — because it controls what the preview shows. */
.rr-mindmap-preview-modebar {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding-bottom: 8px;
    margin-bottom: 10px;
    border-bottom: 1px solid <<colour tiddler-border>>;
}
.rr-mindmap-preview-modebar-title {
    flex: 1 1 auto;
    font-family: var(--theme-monospace-font, monospace);
    font-size: 0.8em;
    opacity: 0.7;
    word-break: break-all;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.rr-mindmap-preview-modebar .rr-mindmap-inspect-mode-select {
    flex: 0 0 auto;
}
.rr-mindmap-preview-body {
    line-height: 1.5;
}
.rr-mindmap-preview-body .rr-text-view-editable {
    cursor: text;
}
.rr-mindmap-preview-edit {
    display: flex;
    flex-direction: column;
}
.rr-mindmap-preview-edit .tc-edit-texteditor {
    min-height: 220px;
    width: 100%;
}

.rr-mindmap-toolbar {
    display: flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.25em 0.4em;
    font-size: 0.85em;
    border-bottom: 1px solid var(--theme-tiddler-border, #e0e0e0);
    background: var(--theme-tiddler-background, transparent);
}

.rr-mindmap-toolbar .rr-mindmap-engine,
.rr-mindmap-toolbar .rr-mindmap-producer {
    opacity: 0.65;
    font-family: var(--theme-monospace-font, monospace);
}

/* Cascade-confirm modal. Self-contained: defines its own page-darkening +
   centering layer (does NOT rely on kn-modal-overlay cascade) so a missing
   knowledge-app stylesheet or a CSS load-order race can't leave the card
   underneath the dim wash. */
.rr-mindmap-cascade-overlay {
    position: fixed;
    inset: 0;
    z-index: 9001;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;
}
.rr-mindmap-cascade-modal {
    position: relative;
    z-index: 1;
    max-width: 460px;
    width: 90vw;
    background: <<colour tiddler-background>>;
    color: <<colour foreground>>;
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    overflow: hidden;
}
.rr-mindmap-cascade-modal-header {
    padding: 12px 16px;
    border-bottom: 1px solid <<colour tiddler-border>>;
    background: <<colour message-background>>;
}
.rr-mindmap-cascade-modal-body {
    padding: 16px;
    line-height: 1.5;
}
.rr-mindmap-cascade-modal-body > div {
    margin-bottom: 0.6em;
}
.rr-mindmap-cascade-modal-body > div:last-child {
    margin-bottom: 0;
}
.rr-mindmap-cascade-modal-hint {
    font-size: 0.85em;
    opacity: 0.7;
}
.rr-mindmap-cascade-modal-actions {
    padding: 12px 16px;
    border-top: 1px solid <<colour tiddler-border>>;
    display: flex;
    gap: 12px;
    justify-content: flex-end;
}

/* Floating bottom-right action panel — matches the visual style of
   mind-elixir's own built-in toolbars (.mind-elixir-toolbar.rb). We add it
   above mind-elixir's bottom-right zoom panel so the two stack vertically. */
.rr-mindmap-actions {
    position: absolute;
    right: 20px;
    bottom: 80px;
    z-index: 50;
    display: flex;
    gap: 8px;
    padding: 8px;
    background: var(--theme-tiddler-background, #fff);
    color: var(--theme-foreground, #333);
    border-radius: 5px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
}

.rr-mindmap-edit-btn {
    min-width: 28px;
    height: 24px;
    padding: 0 0.5em;
    font-size: 1.1em;
    line-height: 1;
    border: 1px solid var(--theme-tiddler-border, #d0d0d0);
    background: var(--theme-tiddler-background, transparent);
    color: inherit;
    border-radius: 3px;
    cursor: pointer;
}
.rr-mindmap-edit-btn:hover:not(:disabled) {
    background: var(--theme-foreground, #000);
    color: var(--theme-background, #fff);
}
.rr-mindmap-edit-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

.rr-mindmap-label-field-select,
.rr-mindmap-inspect-mode-select {
    height: 24px;
    padding: 0 4px;
    font-size: 0.85em;
    line-height: 1;
    border: 1px solid <<colour tiddler-border>>;
    background: <<colour tiddler-background>>;
    color: inherit;
    border-radius: 3px;
    cursor: pointer;
}

/* Slide pane — replaces the body preview when the inspect-mode dropdown is
   set to "slides". Renders a list of slide cards with view/edit affordances. */
.rr-mindmap-slide-pane {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.rr-mindmap-slide-pane-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6em;
    padding-bottom: 6px;
    border-bottom: 1px solid <<colour tiddler-border>>;
}
.rr-mindmap-slide-pane-header strong {
    word-break: break-all;
}
.rr-mindmap-slide-count {
    font-size: 0.82em;
    opacity: 0.65;
    white-space: nowrap;
}
.rr-mindmap-slide-empty {
    padding: 1em 0;
    opacity: 0.65;
    font-style: italic;
}
.rr-mindmap-slide-card {
    border: 1px solid <<colour tiddler-border>>;
    border-radius: 4px;
    background: <<colour tiddler-background>>;
    overflow: hidden;
}
.rr-mindmap-slide-card-editing {
    box-shadow: 0 0 0 2px <<colour primary>>;
}
.rr-mindmap-slide-card-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    background: <<colour message-background>>;
    border-bottom: 1px solid <<colour tiddler-border>>;
    font-size: 0.85em;
}
.rr-mindmap-slide-index {
    font-weight: bold;
}
.rr-mindmap-slide-layout-label {
    font-family: var(--theme-monospace-font, monospace);
    opacity: 0.6;
    font-size: 0.85em;
}
.rr-mindmap-slide-card-controls {
    margin-left: auto;
    display: flex;
    gap: 2px;
}
.rr-mindmap-slide-ctrl {
    min-width: 22px;
    padding: 1px 5px;
    border: 1px solid transparent;
    border-radius: 3px;
    cursor: pointer;
    line-height: 1;
}
.rr-mindmap-slide-ctrl:hover {
    background: <<colour foreground>>;
    color: <<colour background>>;
}
.rr-mindmap-slide-ctrl-danger:hover {
    background: #b04040;
    color: #fff;
}
.rr-mindmap-slide-card-body {
    padding: 8px 10px;
}
.rr-mindmap-slide-content {
    line-height: 1.5;
}
.rr-mindmap-slide-content-title {
    text-align: center;
    font-size: 1.15em;
    padding: 8px 4px;
}
.rr-mindmap-slide-content-title h1,
.rr-mindmap-slide-content-title h2 {
    margin: 0;
}
.rr-mindmap-slide-content-bullets ul,
.rr-mindmap-slide-content-bullets ol {
    margin: 4px 0;
    padding-left: 1.4em;
}
.rr-mindmap-slide-content-error {
    color: #a00;
    font-family: var(--theme-monospace-font, monospace);
    font-size: 0.85em;
    white-space: pre-wrap;
}
.rr-mindmap-slide-edit-form {
    display: flex;
    flex-direction: column;
    gap: 6px;
}
.rr-mindmap-slide-edit-label {
    font-size: 0.85em;
    opacity: 0.8;
    display: flex;
    align-items: center;
    gap: 6px;
}
.rr-mindmap-slide-edit-text {
    width: 100%;
    min-height: 140px;
    font-family: var(--theme-monospace-font, monospace);
    font-size: 0.9em;
    padding: 6px;
    border: 1px solid <<colour tiddler-border>>;
    border-radius: 3px;
    resize: vertical;
    box-sizing: border-box;
}
.rr-mindmap-slide-edit-notes {
    flex: 1 1 auto;
    padding: 3px 6px;
    border: 1px solid <<colour tiddler-border>>;
    border-radius: 3px;
    font-size: 0.9em;
}
.rr-mindmap-slide-edit-buttons {
    display: flex;
    gap: 8px;
    margin-top: 4px;
}
.rr-mindmap-slide-save-btn {
    background: <<colour primary>>;
    color: <<colour background>>;
    border: 1px solid <<colour primary>>;
    border-radius: 3px;
    padding: 4px 12px;
    cursor: pointer;
}
.rr-mindmap-slide-cancel-btn {
    background: <<colour tiddler-background>>;
    border: 1px solid <<colour tiddler-border>>;
    border-radius: 3px;
    padding: 4px 12px;
    cursor: pointer;
}
.rr-mindmap-slide-add-row {
    margin-top: 6px;
}
.rr-mindmap-slide-add-btn {
    background: <<colour tiddler-background>>;
    border: 1px dashed <<colour tiddler-border>>;
    border-radius: 4px;
    padding: 6px 14px;
    cursor: pointer;
    width: 100%;
}
.rr-mindmap-slide-add-btn:hover {
    background: <<colour message-background>>;
}

.rr-mindmap-orphan-badge {
    margin-left: auto;
    color: <<colour message-foreground>>;
    background: transparent;
    border: 1px solid transparent;
    padding: 1px 6px;
    border-radius: 3px;
    cursor: pointer;
    font: inherit;
    font-size: 0.85em;
}
.rr-mindmap-orphan-badge:hover {
    background: <<colour message-background>>;
    border-color: <<colour tiddler-border>>;
}

/* Presentation selector — top canvas toolbar. Lives there because picking a
   presentation is view-level chrome, parallel to producer/engine labels.
   When the orphan badge is hidden, the selector floats right via its own
   margin-left:auto so the label still sits next to it. */
.rr-mindmap-presentation-label {
    margin-left: auto;
    font-family: var(--theme-monospace-font, monospace);
    opacity: 0.65;
}
.rr-mindmap-orphan-badge + .rr-mindmap-presentation-label {
    margin-left: 0.6em;
}
.rr-mindmap-presentation-select {
    height: 22px;
    padding: 0 4px;
    font-size: 0.85em;
    line-height: 1;
    max-width: 180px;
    border: 1px solid <<colour tiddler-border>>;
    background: <<colour tiddler-background>>;
    color: inherit;
    border-radius: 3px;
    cursor: pointer;
}

/* Presentation toggle button (actions panel). Same chrome as the other
   edit-btns; coloured plus/minus glyph. */
.rr-mindmap-presentation-toggle-btn {
    font-weight: bold;
}

/* Presentation pane — third inspect-mode. Stacks per-member node sections,
   each containing the node's slides rendered with their layout class. */
.rr-mindmap-presentation-pane {
    display: flex;
    flex-direction: column;
    gap: 14px;
}
.rr-mindmap-presentation-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6em;
    padding-bottom: 6px;
    border-bottom: 1px solid <<colour tiddler-border>>;
}
.rr-mindmap-presentation-meta {
    font-size: 0.82em;
    opacity: 0.65;
    white-space: nowrap;
}
.rr-mindmap-presentation-empty {
    padding: 1em 0;
    opacity: 0.65;
    font-style: italic;
}
.rr-mindmap-presentation-node {
    border-left: 3px solid <<colour tiddler-border>>;
    padding-left: 10px;
}
.rr-mindmap-presentation-node-selected {
    border-left-color: <<colour primary>>;
}
.rr-mindmap-presentation-node-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6em;
    margin-bottom: 6px;
}
.rr-mindmap-presentation-node-title {
    font-weight: bold;
    word-break: break-all;
}
.rr-mindmap-presentation-node-meta {
    font-size: 0.8em;
    opacity: 0.6;
    white-space: nowrap;
}
.rr-mindmap-presentation-node-empty {
    font-size: 0.85em;
    opacity: 0.55;
    font-style: italic;
    padding: 4px 0;
}
.rr-mindmap-presentation-slide {
    border: 1px solid <<colour tiddler-border>>;
    border-radius: 3px;
    padding: 8px 10px;
    margin-bottom: 6px;
    background: <<colour tiddler-background>>;
}

.rr-mindmap-preview-empty,
.rr-mindmap-preview-modebar-empty {
    opacity: 0.55;
    font-style: italic;
}
.rr-mindmap-preview-empty {
    padding: 1em 0;
}

.rr-mindmap-error {
    padding: 1em;
    border: 1px solid var(--theme-message-error-border, #b04040);
    background: var(--theme-message-error-background, #fff0f0);
    color: var(--theme-message-error-color, #800000);
    font-family: var(--theme-monospace-font, monospace);
    white-space: pre-wrap;
}

/* Fix TW's auto-<p> wrapping when $mindmap is invoked via $transclude $mode="block".
   Same pattern as cytoscape-engine. */
.rr-mindmap > p { display: contents; margin: 0; }
