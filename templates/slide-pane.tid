title: $:/plugins/rimir/mindmap/templates/slide-pane
tags: $:/tags/Macro

\procedure mm-slide-card(slideTitle, owner, stateKey, editingState, idx, slideCount)

<!-- IMPORTANT (re: tw-edit-text-rerender gotcha): the outer $let must NOT
     bind any fields that the inline edit form writes to. Otherwise typing in
     <$edit-text> rewrites the field → the outer $let re-evaluates → the
     entire card re-renders → the just-mounted <$edit-text> widgets are
     destroyed and recreated, throwing the cursor (and selecting all text
     when the recreated control has focus="yes"). The edit-form $edit-text
     widgets read/write the slide tiddler's fields directly; the read-only
     header binds caption/layout in its OWN narrow $let so updating them
     re-renders the header span only, not the edit form. -->
<$let isEditing={{{ [<editingState>get[text]match<slideTitle>] }}}
      humanIdx=<<idx>>>
<div class={{{ [[rr-mindmap-slide-card]] [<isEditing>!is[blank]then[rr-mindmap-slide-card-editing]] +[join[ ]] }}}>
<div class="rr-mindmap-slide-card-header">
<span class="rr-mindmap-slide-index">#<$text text=<<humanIdx>>/></span>
<$let leafTitle={{{ [<slideTitle>split[/]last[]] }}}
      caption={{{ [<slideTitle>get[caption]] }}}
      layout={{{ [<slideTitle>get[mm.slide-layout]] }}}
      displayName={{{ [<caption>!is[blank]] ~[<leafTitle>] }}}>
<span class="rr-mindmap-slide-caption"><$text text=<<displayName>>/></span>
<span class="rr-mindmap-slide-layout-label"><$text text=<<layout>>/></span>
</$let>
<span class="rr-mindmap-slide-card-controls">
<$list filter="[<isEditing>is[blank]]" variable="_">
<$button class="tc-btn-invisible rr-mindmap-slide-ctrl" tooltip="Edit slide">
<$action-setfield $tiddler=<<editingState>> text=<<slideTitle>>/>
&#x270e;
</$button>
<$list filter="[<humanIdx>!match[1]]" variable="_">
<$button class="tc-btn-invisible rr-mindmap-slide-ctrl" tooltip="Move up">
<$action-listops $tiddler=<<owner>> $field="mm.slide-order" $subfilter="+[move:-1<slideTitle>]"/>
&#x2191;
</$button>
</$list>
<$list filter="[<humanIdx>!match<slideCount>]" variable="_">
<$button class="tc-btn-invisible rr-mindmap-slide-ctrl" tooltip="Move down">
<$action-listops $tiddler=<<owner>> $field="mm.slide-order" $subfilter="+[move:1<slideTitle>]"/>
&#x2193;
</$button>
</$list>
<$button class="tc-btn-invisible rr-mindmap-slide-ctrl rr-mindmap-slide-ctrl-danger" tooltip="Delete slide">
<$action-listops $tiddler=<<owner>> $field="mm.slide-order" $subfilter="-[<slideTitle>]"/>
<$action-deletetiddler $tiddler=<<slideTitle>>/>
&#x2715;
</$button>
</$list>
</span>
</div>
<div class="rr-mindmap-slide-card-body">
<$list filter="[<isEditing>!is[blank]]" variable="_" emptyMessage="""<$let layout={{{ [<slideTitle>get[mm.slide-layout]] }}}><div class={{{ [[rr-mindmap-slide-content rr-mindmap-slide-content-]] +[addsuffix<layout>] }}}><$transclude $tiddler=<<slideTitle>> $mode="block"/></div></$let>""">
<div class="rr-mindmap-slide-edit-form">
<label class="rr-mindmap-slide-edit-label">Caption:
<$edit-text tiddler=<<slideTitle>> field="caption" tag="input" class="rr-mindmap-slide-edit-caption" placeholder="(optional display name)" focus="yes"/>
</label>
<label class="rr-mindmap-slide-edit-label">Layout:
<$select tiddler=<<slideTitle>> field="mm.slide-layout" default="default">
<option>default</option>
<option>title</option>
<option>bullets</option>
</$select>
</label>
<label class="rr-mindmap-slide-edit-label">Notes (presenter):
<$edit-text tiddler=<<slideTitle>> field="mm.slide-notes" tag="input" class="rr-mindmap-slide-edit-notes" placeholder="(single-line presenter notes)"/>
</label>
<label class="rr-mindmap-slide-edit-label">Body (wikitext):</label>
<$edit-text tiddler=<<slideTitle>> tag="textarea" class="rr-mindmap-slide-edit-text"/>
<div class="rr-mindmap-slide-edit-buttons">
<$button class="rr-mindmap-slide-save-btn">
<$action-setfield $tiddler=<<editingState>> text=""/>
Done
</$button>
</div>
</div>
</$list>
</div>
</div>
</$let>

\end mm-slide-card

\procedure mm-slide-pane(previewTitle, stateKey)

<$let editingState={{{ [<stateKey>addprefix[$:/state/rimir/mindmap/]addsuffix[/slide-editing]] }}}
      slideCount={{{ [<previewTitle>mm-slide-count[]] }}}>
<div class="rr-mindmap-slide-pane">
<div class="rr-mindmap-slide-pane-header">
<span class="rr-mindmap-slide-count"><$text text=<<slideCount>>/> slide<$list filter="[<slideCount>!match[1]]" variable="_">s</$list></span>
</div>
<$list filter="[<previewTitle>mm-slides[]]" variable="slideTitle" counter="idx" emptyMessage="""<div class='rr-mindmap-slide-empty'>No slides yet. Click "+ Add slide" to create one.</div>""">
<$transclude $variable="mm-slide-card" slideTitle=<<slideTitle>> owner=<<previewTitle>> stateKey=<<stateKey>> editingState=<<editingState>> idx=<<idx>> slideCount=<<slideCount>>/>
</$list>
<div class="rr-mindmap-slide-add-row">
<$button class="rr-mindmap-slide-add-btn">
<$action-sendmessage $message="rr-mindmap-add-slide" owner=<<previewTitle>>/>
+ Add slide
</$button>
</div>
</div>
</$let>

\end mm-slide-pane
