title: $:/plugins/rimir/mindmap/templates/default-preview-body
type: text/vnd.tiddlywiki

\whitespace trim

<!--
   Default body-template for the mindmap preview pane. Used when the view's
   `mm.preview-body-template` field is empty AND no `previewKind` synthetic
   classifier is in effect. Receives `previewTitle` in scope (the backing
   tiddler of the currently selected node).

   Branches on the typed-system `note-type` field of the selected tiddler:
     * streams              → render via the streams ViewTemplate (the bare
                              $transclude path renders blank because stream
                              notes keep their body empty and put content in
                              tagged child tiddlers).
     * md-text              → falls through to rr-text-view-editable. The
                              host's note-type-change handler also stamps
                              `type: text/x-markdown` on the tiddler so the
                              inner $transclude picks the markdown parser
                              (rimir/frontmatter handles the YAML round-trip
                              when the tiddler is saved as a .md file).
     * tw-text / text / ""  → falls through to rr-text-view-editable too.
                              Same code path as md-text — the tiddler's
                              `type` field chooses the parser.

   Per-view overrides (set `mm.preview-body-template` on the view tiddler)
   still take precedence. Plugin-namespace shadow means users can replace
   this dispatcher by overriding the title.
-->

<$let noteType={{{ [<previewTitle>get[note-type]] }}}>
<%if [<noteType>match[streams]] %>
<!-- Blank `editState` inside the streams branch so the rimir/theme
     `rr-text-editor-leave-edit` EditorToolbar item's gate `[<editState>!is[blank]]`
     fails inside streams' row-edit textarea. Otherwise that toolbar item
     registers `data-tw-keyboard-shortcut="ctrl+Enter"`, which the framed-engine
     binds via preventDefault + stopPropagation before streams' own
     `<$keyboard-plus>` save-and-exit handler can fire — symptom: ctrl-Enter
     in a streams row-edit does nothing. The text branches below keep the
     real editState so rr-text-view-editable's dblclick-to-edit works. -->
<$let editState="">
<$tiddler tiddler=<<previewTitle>>>
<$transclude $tiddler="$:/plugins/sq/streams/nodes-list-template" $mode="block"/>
</$tiddler>
</$let>
<%else%>
<$let viewTiddler=<<previewTitle>>>
<$transclude $tiddler="$:/plugins/rimir/theme/rr-text-view-editable" $mode="block"/>
</$let>
<%endif%>
</$let>
