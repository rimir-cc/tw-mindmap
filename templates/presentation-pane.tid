title: $:/plugins/rimir/mindmap/templates/presentation-pane
tags: $:/tags/Macro

\procedure mm-presentation-pane(previewTitle, stateKey, viewTitle)

<$let presentationTitle={{{ [<viewTitle>get[mm.presentation]] }}}>

<$list filter="[<presentationTitle>is[blank]]" variable="_">
<div class="rr-mindmap-presentation-empty">
No active presentation. Use the dropdown above to pick or create one.
</div>
</$list>

<$list filter="[<presentationTitle>!is[blank]]" variable="_">
<$let nodesList={{{ [<presentationTitle>get[mm.slides-order]] }}}
      nodeCount={{{ [enlist<nodesList>count[]] }}}>
<div class="rr-mindmap-presentation-pane">
<div class="rr-mindmap-presentation-header">
<strong><$text text=<<presentationTitle>>/></strong>
<span class="rr-mindmap-presentation-meta"><$text text=<<nodeCount>>/> node<$list filter="[<nodeCount>!match[1]]" variable="_">s</$list></span>
</div>

<$list filter="[enlist<nodesList>]" variable="nodeTitle" emptyMessage="""<div class='rr-mindmap-presentation-empty'>No nodes added yet. Select a node in the canvas and click "+ Add to presentation" in the bottom-right panel.</div>""">
<$let nodeSlideCount={{{ [<nodeTitle>mm-slide-count[]] }}}
      isSelected={{{ [<previewTitle>match<nodeTitle>] }}}>
<div class={{{ [[rr-mindmap-presentation-node]] [<isSelected>!is[blank]then[rr-mindmap-presentation-node-selected]] +[join[ ]] }}}>
<div class="rr-mindmap-presentation-node-header">
<$button class="rr-mindmap-presentation-node-title rr-link-btn" tooltip="Select this node in the canvas">
<$action-sendmessage $message="rr-mindmap-select-node-by-title" title=<<nodeTitle>>/>
<$text text=<<nodeTitle>>/>
</$button>
<span class="rr-mindmap-presentation-node-meta"><$text text=<<nodeSlideCount>>/> slide<$list filter="[<nodeSlideCount>!match[1]]" variable="_">s</$list></span>
</div>
<$list filter="[<nodeTitle>mm-slides[]]" variable="slideTitle" counter="oneIdx" emptyMessage="""<div class='rr-mindmap-presentation-node-empty'>(no slides on this node)</div>""">
<$let layout={{{ [<slideTitle>get[mm.slide-layout]] }}}
      caption={{{ [<slideTitle>get[caption]] }}}
      leafTitle={{{ [<slideTitle>split[/]last[]] }}}
      displayName={{{ [<caption>!is[blank]] ~[<leafTitle>] }}}>
<div class="rr-mindmap-presentation-slide">
<div class="rr-mindmap-presentation-slide-label">Slide <$text text=<<oneIdx>>/> · <em><$text text=<<displayName>>/></em> · <span class="rr-mindmap-presentation-slide-layout"><$text text=<<layout>>/></span></div>
<div class={{{ [[rr-mindmap-presentation-slide-body rr-mindmap-slide-content-]] +[addsuffix<layout>] }}}>
<$transclude $tiddler=<<slideTitle>> $mode="block"/>
</div>
</div>
</$let>
</$list>
</div>
</$let>
</$list>

</div>
</$let>
</$list>

</$let>

\end mm-presentation-pane
